@model TripPlanner_Construction.Entités.Voyage

@{
    ViewData["Title"] = "Créer un voyage";
}

<div class="container mt-5" style="max-width: 850px;">

    <div class="mb-4">
        <h1 class="fw-bold">Créer un nouveau voyage</h1>
        <p class="text-muted">
            Ajoutez les informations principales de votre voyage
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div class="mb-4">
                    <label asp-for="Destination" class="form-label fw-semibold">
                        Destination
                    </label>
                    <input asp-for="Destination"
                           class="form-control form-control-lg"
                           placeholder="Ex : Paris" />
                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">
                        <label asp-for="DateDebut" class="form-label fw-semibold">
                            Date de début
                        </label>
                        <input asp-for="DateDebut"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="DateFin" class="form-label fw-semibold">
                            Date de fin
                        </label>
                        <input asp-for="DateFin"
                               type="date"
                               class="form-control" />
                    </div>

                </div>

                <div class="mb-4">
                    <label asp-for="DatelimiteVote" class="form-label fw-semibold">
                        Date limite pour voter
                    </label>
                    <input asp-for="DatelimiteVote"
                           type="date"
                           class="form-control" />
                </div>

               

                <div class="d-flex gap-2">

                    <button type="submit" class="btn-tripplanner">
                        Créer
                    </button>

                    <a asp-action="Index"
                           class="btn-tripplanner">
                        Annuler
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>