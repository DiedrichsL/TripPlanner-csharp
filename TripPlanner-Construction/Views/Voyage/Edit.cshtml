@model TripPlanner_Construction.Entités.Voyage

@{
    ViewData["Title"] = "Modifier le voyage";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="fw-bold">Modifier le voyage</h2>
    <p class="text-muted">Modifiez les informations du voyage</p>

    <div class="card p-4 shadow-sm">
        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Organisateurid" />
            <input type="hidden" asp-for="StatutVote" />

            <div class="mb-3">
                <label asp-for="Destination" class="form-label">Destination</label>
                <input asp-for="Destination" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="DateDebut" class="form-label">Date du début</label>
                <input asp-for="DateDebut" type="date" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="DateFin" class="form-label">Date de fin</label>
                <input asp-for="DateFin" type="date" class="form-control" />
            </div>

            <div class="mb-4">
                <label asp-for="DatelimiteVote" class="form-label">Date limite pour voter</label>
                <input asp-for="DatelimiteVote" type="date" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-tripplanner">
                    Sauvegarder
                </button>

                <a asp-controller="Voyage"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                    Retour
                </a>
            </div>

        </form>
    </div>
</div>