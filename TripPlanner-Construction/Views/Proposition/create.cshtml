@model TripPlanner_Construction.Entités.Proposition

@{
    ViewData["Title"] = "Ajouter une proposition";
}

<div class="container mt-4" style="max-width:700px;">

    <h2 class="fw-bold">Ajouter une proposition</h2>
    <p class="text-muted">
        Proposez une activité, un hébergement ou un transport
    </p>

    <div class="card p-4 shadow-sm">

        <form asp-action="Create" method="post">

            <input type="hidden" asp-for="VoyageId" />

            <div class="mb-3">
                <label asp-for="Titre" class="form-label">Titre</label>
                <input asp-for="Titre" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="TypeProposition" class="form-label">Type</label>
                <select asp-for="TypeProposition" class="form-select">
                    <option value="">Choisir</option>
                    <option value="Activité">Activité</option>
                    <option value="Hébergement">Hébergement</option>
                    <option value="Transport">Transport</option>
                </select>
            </div>

            <div class="mb-4">
                <label asp-for="PrixEstime" class="form-label">Prix estimé</label>
                <input asp-for="PrixEstime" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-tripplanner">
                    Ajouter
                </button>

                <a asp-controller="Voyage"
                       asp-action="Details"
                       asp-route-id="@Model.VoyageId"
                       class="btn btn-outline-secondary">
                    Retour
                </a>
            </div>

        </form>

    </div>
</div>